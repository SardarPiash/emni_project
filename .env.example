# =========================================================
# eBook Store — environment configuration (TEMPLATE)
# Copy to ".env" and fill in real values. Never commit ".env".
# On Hostinger, ".env" sits ONE LEVEL ABOVE public_html.
# =========================================================

# ---------- App ----------
APP_ENV=local                      # local | production
WP_HOME=http://localhost:8080      # public site URL (no trailing slash)
WP_SITEURL=http://localhost:8080   # WordPress core URL (usually same as WP_HOME)
WP_DEBUG=true                      # true while developing, false in production
WP_DEBUG_LOG=true                  # write errors to wp-content/debug.log
WP_DEBUG_DISPLAY=false             # never show PHP errors on the page
DISALLOW_FILE_EDIT=true            # disable theme/plugin file editor in admin

# ---------- Database (MySQL / MariaDB) ----------
DB_NAME=ebookstore                 # database name
DB_USER=ebookstore_user            # dedicated DB user (never root)
DB_PASSWORD=change_me              # DB user password
DB_HOST=127.0.0.1                  # 127.0.0.1 locally; Hostinger value in production
DB_PREFIX=wp_                      # table prefix
DB_CHARSET=utf8mb4                 # character set
DB_COLLATE=utf8mb4_unicode_ci      # collation (portable to Hostinger MariaDB)

# ---------- Security salts (generate unique random 64-char values) ----------
# Generate at https://api.wordpress.org/secret-key/1.1/salt/ (avoid # and quotes)
AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=

# ---------- Store ----------
STORE_NAME="eBook Store"           # site title (followed live by the site)
STORE_TAGLINE="Practical eBooks for curious minds. Buy once, download instantly, read anywhere."  # hero + footer text
STORE_SUPPORT_EMAIL=support@example.com  # support email shown in footer
STORE_ADMIN_EMAIL=support@example.com  # receives store notifications (new orders, failed orders); also the WordPress admin email
SITE_LOCALE=en_US                  # WordPress site language
SITE_TIMEZONE=America/New_York     # PHP timezone name for dates/times in the store
STORE_BASE_CURRENCY=USD            # WooCommerce base currency
STORE_SECONDARY_CURRENCY=GBP       # second display/payment currency
STORE_GBP_EXCHANGE_RATE=0.79       # fallback only: 1 USD = X GBP if the automatic (ECB) and manual rates in WooCommerce → Exchange Rate are unavailable
STORE_DOWNLOAD_LIMIT=5             # downloads per purchase (empty = unlimited)
STORE_DOWNLOAD_EXPIRY_DAYS=30      # days (empty = never)

# ---------- Email (SMTP) ----------
SMTP_HOST=smtp.hostinger.com       # SMTP server
SMTP_PORT=465                      # 465 for ssl, 587 for tls
SMTP_ENCRYPTION=ssl                # ssl | tls | none
SMTP_AUTH=true                     # true if the server needs a login
SMTP_USER=no-reply@example.com     # SMTP login
SMTP_PASSWORD=change_me            # SMTP password (never share it)
MAIL_FROM_EMAIL=no-reply@example.com  # "From" address of all emails
MAIL_FROM_NAME="eBook Store"       # "From" name of all emails

# ---------- Dummy payment gateway ----------
DUMMY_GATEWAY_ENABLED=true         # set false in production

# ---------- Footer / social links ----------
LINK_FACEBOOK=                     # full URL, empty = hidden
LINK_INSTAGRAM=                    # full URL, empty = hidden
LINK_X=                            # full URL, empty = hidden
LINK_PRIVACY_POLICY=/privacy-policy  # path or full URL
LINK_TERMS=/terms                  # path or full URL

# ---------- Home page hero slideshow ----------
HERO_AUTOPLAY_SECONDS=6           # default seconds per slide (0 = no autoplay); can be overridden in Hero Slides > Settings

# ---------- Security ----------
SECURITY_PROTECTED_ROLES=administrator,shop_manager   # only these accounts trigger lockouts
SECURITY_MAX_LOGIN_ATTEMPTS=5            # counted failures (admin accounts + unknown usernames) before a block
SECURITY_LOCKOUT_MINUTES=120             # blocks admin area + admin-account logins only; customers never blocked
SECURITY_IP_ALLOWLIST=127.0.0.1,::1      # never blocked; LOCAL ONLY — leave empty on the live site; more can be added in admin
SECURITY_TRUSTED_PROXY_HEADER=           # empty = use REMOTE_ADDR; set only if behind a known proxy/CDN (e.g. X-Forwarded-For)
SECURITY_TRUSTED_PROXIES=                # proxy/CDN IPs or ranges (comma-separated); the header is trusted only from these
SECURITY_DISABLE_XMLRPC=true             # XML-RPC is not used by this store
SECURITY_UNLOCK_LINK_MINUTES=15          # emergency unlock link lifetime
SECURITY_RESET_EMAIL_COOLDOWN_SECONDS=120  # same account gets max one password-reset email per this many seconds
SECURITY_LOG_RETENTION_DAYS=30           # Security → Activity log is cleaned after this many days
SECURITY_HSTS=false                      # true only in production with working HTTPS
SECURITY_TEST_IP_OVERRIDE=false          # TESTS ONLY, works only with APP_ENV=local; keep false
