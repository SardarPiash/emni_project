# ---------------------------------------------------------
# Deny access to any .env file (fallback — the real .env lives
# one level above the web root). Effective on Hostinger
# (LiteSpeed/Apache); the local PHP built-in server ignores it.
# ---------------------------------------------------------
<FilesMatch "^\.env">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>

# ---------------------------------------------------------
# Hardening (Hostinger / LiteSpeed / Apache)
# ---------------------------------------------------------
# No directory listings.
Options -Indexes

# Block files that should never be requested directly.
<FilesMatch "^(wp-config\.php|xmlrpc\.php|readme\.html|license\.txt|wp-config-sample\.php)$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>

# Block log, SQL dump and backup files anywhere under the web root.
<FilesMatch "\.(log|sql|sql\.gz|bak|swp)$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>

# Readme / changelog files reveal plugin and theme versions (e.g. the test gateway's README).
<FilesMatch "^(readme|README|changelog|CHANGELOG)\.(txt|md|html)$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>

# Never run PHP from the uploads folder (uploaded files are only images/PDFs).
# WooCommerce's own protection of wp-content/uploads/woocommerce_uploads/ stays as it is.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^wp-content/uploads/.*\.(php[0-9]?|phtml|phar|pht)$ - [F,L,NC]
</IfModule>
# BEGIN WordPress
# The directives (lines) between "BEGIN WordPress" and "END WordPress" are
# dynamically generated, and should only be modified via WordPress filters.
# Any changes to the directives between these markers will be overwritten.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
# END WordPress
